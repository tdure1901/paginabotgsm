      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "WhatsApp Cloud API"
        }
      },
      "notes": "Corregido: la dirección ahora sale de Consigue_fila (antes siempre quedaba 'Sin especificar')",
      "notesInFlow": true
    },
