        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  messaging_product: \"whatsapp\",\n  to: $json.telefono_destino,\n  type: \"template\",\n  template: {\n    name: \"aviso_reclamo\",\n    language: { code: \"es_AR\" },\n    components: [\n      {\n        type: \"body\",\n        parameters: [\n          { type: \"text\", text: $('Consigue_fila').item.json.solicitante },\n          { type: \"text\", text: $('Consigue_fila').item.json.numero_reclamo },\n          { type: \"text\", text: $('Consigue_fila').item.json.motivo || \"Sin especificar\" },\n          { type: \"text\", text: (($('Consigue_fila').item.json.calle || \"\") + \" \" + ($('Consigue_fila').item.json.numero_domicilio || \"\")).trim() || \"Sin especificar\" }\n        ]\n      }\n    ]\n  }\n}\n}}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
