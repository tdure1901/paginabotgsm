    {
      "parameters": {
        "jsCode": "// Arma el mensaje de WhatsApp (texto libre o plantilla) a partir de lo que mandó el panel\nconst b = $('Panel').first().json.body || {};\nconst r = $('Buscar reclamo').first().json;\nconst usuario = $('Verificar usuario').first().json.body || {};\n\nlet payload, contenido;\nif (b.tipo === 'plantilla') {\n  if (!b.plantilla) throw new Error('Falta el nombre de la plantilla');\n  const params = Array.isArray(b.parametros) ? b.parametros : [];\n  payload = {\n    messaging_product: 'whatsapp',\n    to: r.telefono_normalizado,\n    type: 'template',\n    template: {\n      name: b.plantilla,\n      language: { code: b.idioma || 'es_AR' },\n      components: params.length ? [{ type: 'body', parameters: params.map(t => ({ type: 'text', text: String(t) })) }] : [],\n    },\n  };\n  contenido = b.texto || `[Plantilla ${b.plantilla}]`;\n} else {\n  const m = String(b.mensaje || '').trim();\n  if (!m) throw new Error('El mensaje está vacío');\n  payload = { messaging_product: 'whatsapp', to: r.telefono_normalizado, type: 'text', text: { body: m } };\n  contenido = m;\n}\n\nreturn [{ json: { payload, contenido, tipo: b.tipo === 'plantilla' ? 'plantilla' : 'texto', reclamo_id: r.id, email: usuario.email || null } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        120
      ],
