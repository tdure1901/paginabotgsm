# Supabase: los mismos valores que usa el proyecto de Lovable
# (si se dejan vacíos la app arranca en "modo demo" con datos de ejemplo)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Webhook de n8n que manda por WhatsApp los mensajes escritos a mano en "Conversaciones"
# Recibe POST JSON: { reclamo_id, numero_reclamo, telefono, solicitante, mensaje }
VITE_N8N_WEBHOOK_MENSAJE=
