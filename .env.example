# Supabase: los mismos valores que usa el proyecto de Lovable
# (si se dejan vacíos la app arranca en "modo demo" con datos de ejemplo)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Webhook de n8n (workflow n8n/mensajes-panel.json) que manda los mensajes escritos en "Conversaciones".
# Recibe POST JSON con el token de sesión del usuario:
#   { reclamo_id, tipo: "texto", mensaje }  o  { reclamo_id, tipo: "plantilla", plantilla, idioma, parametros, texto }
VITE_N8N_WEBHOOK_MENSAJE=
