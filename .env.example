# Supabase (si no se completa, la app funciona en "modo demo" con datos locales)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Webhooks de n8n
# Dispara el envío masivo del bot para un lote recién subido
VITE_N8N_WEBHOOK_LOTE=
